# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Database (PostgreSQL). Either set DATABASE_URL, or set the individual DB_* values.
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_NAME=defaultdb
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# JWT - use long random strings. Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API (0 locally; 2 behind Netlify -> Render)
TRUST_PROXY_HOPS=0

# Refresh token cookie (secure=true only when served over HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Seed admin account (used by npm run db:seed) - at least 8 characters
ADMIN_EMAIL=admin@thesis.local
ADMIN_PASSWORD=change-me

# File uploads (video detection)
UPLOAD_DIR=./storage
UPLOAD_MAX_FILE_SIZE_MB=200
UPLOAD_MAX_FILES_PER_REQUEST=1
UPLOAD_ALLOWED_EXTENSIONS=mp4,mov,avi,mkv,webm,m4v
UPLOAD_ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/x-msvideo,video/x-matroska,video/webm

# Detection API - mock=true returns simulated detections until the real YOLO API is added.
DETECTION_MOCK=true
DETECTION_API_URL=
DETECTION_API_KEY=
DETECTION_API_TIMEOUT_MS=120000
DETECTION_MOCK_PEDESTRIANS=1

# Traffic signal - transports: log | serial | http
SIGNAL_TRANSPORT=log
SIGNAL_SERIAL_PORT=COM3
SIGNAL_BAUD=9600
SIGNAL_YELLOW_MS=3000
SIGNAL_RED_MS=20000
SIGNAL_CLEAR_GRACE_MS=2000
SIGNAL_ARDUINO_URL=

# Live YOLO webcam pipeline (Python -> Node -> React -> Arduino)
YOLO_LIVE_DETECTION_THRESHOLD_MS=5000
YOLO_LIVE_YELLOW_MS=3000
YOLO_LIVE_STOP_DURATION_MS=15000
YOLO_LIVE_ARDUINO_TRANSPORT=log
YOLO_LIVE_ARDUINO_PORT=COM3
YOLO_LIVE_ARDUINO_BAUD=9600
# Global YOLO enable/disable switch (true=automatic detection, false=manual mode only)
YOLO_LIVE_ENABLED=true

# Shared secret the Python YOLO service sends as X-Ingest-Key (same value in yolo-service/.env).
# Leave empty for local development; ingest is rejected outside development without it.
YOLO_INGEST_KEY=
