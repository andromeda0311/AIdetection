{
  "name": "thesis-backend",
  "version": "1.0.0",
  "description": "Traffic enforcer staff authentication API (Express + TypeScript)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/config/ormconfig.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "typeorm:migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/ormconfig.ts",
    "typeorm:migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/ormconfig.ts src/migrations/InitSchema",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "file-type": "^22.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "pino": "^9.4.0",
    "reflect-metadata": "^0.2.2",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.20",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "arduino-cli": "^0.37.0",
    "pino-pretty": "^11.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
