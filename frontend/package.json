{
  "name": "thesis-frontend",
  "version": "1.0.0",
  "description": "Traffic enforcer staff frontend (Vue 3 + Vite + PrimeVue)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=8192 node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node --max-old-space-size=8192 node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "typecheck": "node --max-old-space-size=8192 node_modules/vue-tsc/bin/vue-tsc.js --noEmit"
  },
  "dependencies": {
    "@tabler/icons-vue": "3.49.0",
    "axios": "^1.7.9",
    "pinia": "^2.3.0",
    "primeicons": "^7.0.0",
    "primevue": "^3.53.1",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vue-tsc": "^2.1.10"
  }
}
