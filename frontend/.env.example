# Base URL of the backend API. Leave unset to use /api: the Vite dev proxy locally
# (/api -> http://localhost:4000) and the Netlify proxy in production.
# VITE_API_URL=http://localhost:4000/api

# Socket.IO origin for live system state (defaults to ws://localhost:4000).
# In production set it to the Render backend, e.g. https://<service>.onrender.com
# VITE_WS_URL=ws://localhost:4000

# Local design preview only: skip login in `npm run dev` (ignored in production builds).
# VITE_AUTH_DISABLED=true
